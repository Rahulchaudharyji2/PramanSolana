// Praman Network - Distributed ACID Database Schema for YugabyteDB (YSQL)
// PostgreSQL 14+ / YSQL wire-compatible

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- 1. DEVELOPERS & ACCESS ----------------
model Developer {
  id                     String         @id @default(uuid())
  email                  String         @unique
  name                   String
  authenticationProvider String         @default("email") @map("authentication_provider")
  passwordHash           String         @map("password_hash")
  avatarUrl              String?        @map("avatar_url")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  projects               Project[]
  subscriptions          Subscription[]
  auditLogs              AuditLog[]

  @@map("developers")
}

// ---------------- 2. PROJECTS & TENANTS ----------------
model Project {
  id                   String                @id @default(uuid())
  developerId          String                @map("developer_id")
  name                 String
  description          String?
  websiteUrl           String?               @map("website_url")
  clientId             String                @unique @map("client_id")
  clientSecretHash     String                @map("client_secret_hash")
  status               String                @default("ACTIVE") // ACTIVE, SUSPENDED, ARCHIVED
  environment          String                @default("DEVELOPMENT") // DEVELOPMENT, STAGING, PRODUCTION
  webhookUrl           String?               @map("webhook_url")
  webhookSecret        String?               @map("webhook_secret")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  developer            Developer             @relation(fields: [developerId], references: [id], onDelete: Cascade)
  apiKeys              ApiKey[]
  allowedDomains       AllowedDomain[]
  callbackUrls         CallbackUrl[]
  consentRecords       ConsentRecord[]
  verificationSessions VerificationSession[]
  verificationEvents   VerificationEvent[]
  auditLogs            AuditLog[]
  subscriptions        Subscription[]

  @@map("projects")
}

// ---------------- 3. API CREDENTIALS ----------------
model ApiKey {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  name        String
  keyPrefix   String    @map("key_prefix")
  keyHash     String    @unique @map("key_hash")
  environment String    @default("DEVELOPMENT")
  scopes      String    @default("read,write")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// ---------------- 4. ALLOWED DOMAINS & VERIFICATION ----------------
model AllowedDomain {
  id                 String    @id @default(uuid())
  projectId          String    @map("project_id")
  domain             String
  verificationMethod String    @default("DNS_TXT") @map("verification_method") // DNS_TXT, HTTP_WELL_KNOWN
  verificationStatus String    @default("PENDING") @map("verification_status") // PENDING, VERIFIED, FAILED, REVOKED
  verificationToken  String    @map("verification_token")
  verifiedAt         DateTime? @map("verified_at")
  lastCheckedAt      DateTime? @map("last_checked_at")
  errorMessage       String?   @map("error_message")
  createdAt          DateTime  @default(now()) @map("created_at")
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, domain])
  @@map("allowed_domains")
}

// ---------------- 5. CALLBACK URLS ----------------
model CallbackUrl {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  callbackUrl String   @map("callback_url")
  status      String   @default("ACTIVE") // ACTIVE, REVOKED
  createdAt   DateTime @default(now()) @map("created_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, callbackUrl])
  @@map("callback_urls")
}

// ---------------- 6. PRAMAN USERS ----------------
model PramanUser {
  id                  String               @id @default(uuid())
  internalUserId      String               @unique @default(uuid()) @map("internal_user_id") // Opaque internal root ID
  email               String               @unique
  emailVerified       Boolean              @default(false) @map("email_verified")
  phone               String?
  solanaWalletAddress String?              @map("solana_wallet_address")
  privyUserId         String?              @map("privy_user_id")
  accountStatus       String               @default("REGISTERED") @map("account_status") // REGISTERED, ENROLLED, SUSPENDED
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  identityTemplates   IdentityTemplate[]
  identityCommitments IdentityCommitment[]
  consentRecords      ConsentRecord[]
  vaultAttributes     VaultAttribute[]

  @@map("praman_users")
}

// ---------------- 7. BIOMETRIC IDENTITY TEMPLATES (VERSIONING) ----------------
model IdentityTemplate {
  id                         String     @id @default(uuid())
  pramanUserId               String     @map("praman_user_id")
  templateVersion            Int        @default(1) @map("template_version") // v1, v2, v3...
  modelVersion               String     @default("facenet-512") @map("model_version") // Model descriptor
  encryptedTemplateReference String     @map("encrypted_template_reference") // Secure ref, zero plaintext biometrics
  commitment                 String     @map("commitment") // Poseidon BN254 commitment hash
  saltHex                    String     @map("salt_hex") // User commitment blinding factor
  status                     String     @default("ACTIVE") // ACTIVE, SUPERSEDED, REVOKED
  enrolledAt                 DateTime   @default(now()) @map("enrolled_at")
  supersededAt               DateTime?  @map("superseded_at")
  createdAt                  DateTime   @default(now()) @map("created_at")
  user                       PramanUser @relation(fields: [pramanUserId], references: [id], onDelete: Cascade)

  @@unique([pramanUserId, templateVersion])
  @@map("identity_templates")
}

// ---------------- 8. IDENTITY COMMITMENTS (ON-CHAIN SOLANA) ----------------
model IdentityCommitment {
  id                   String     @id @default(uuid())
  pramanUserId         String     @map("praman_user_id")
  commitment           String     @unique // Poseidon hash hex
  network              String     @default("solana-devnet")
  transactionSignature String?    @map("transaction_signature")
  circuitVersion       String     @default("Groth16_BN254_v1") @map("circuit_version")
  createdAt            DateTime   @default(now()) @map("created_at")
  user                 PramanUser @relation(fields: [pramanUserId], references: [id], onDelete: Cascade)

  @@map("identity_commitments")
}

// ---------------- 9. ENCRYPTED IDENTITY VAULT ATTRIBUTES ----------------
model VaultAttribute {
  id           String     @id @default(uuid())
  pramanUserId String     @map("praman_user_id")
  attributeKey String     @map("attribute_key") // FULL_NAME, EMAIL, PHONE, DATE_OF_BIRTH, IS_OVER_18
  ciphertext   String     // Base64 AES-256-GCM
  iv           String     // Base64 12-byte IV
  authTag      String     @map("auth_tag") // Base64 16-byte Auth Tag
  keyVersion   Int        @default(1) @map("key_version")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  user         PramanUser @relation(fields: [pramanUserId], references: [id], onDelete: Cascade)

  @@unique([pramanUserId, attributeKey])
  @@map("vault_attributes")
}

// ---------------- 10. CONSENT RECORDS ----------------
model ConsentRecord {
  id                 String     @id @default(uuid())
  pramanUserId       String     @map("praman_user_id")
  projectId          String     @map("project_id")
  pairwiseId         String     @map("pairwise_id") // Isolated pseudonymous ID: prm_user_xxx
  requestedAttributes String    @map("requested_attributes") // JSON array string
  approvedAttributes  String    @map("approved_attributes") // JSON array string
  consentStatus      String     @default("ACTIVE") @map("consent_status") // ACTIVE, REVOKED
  consentVersion     Int        @default(1) @map("consent_version")
  createdAt          DateTime   @default(now()) @map("created_at")
  revokedAt          DateTime?  @map("revoked_at")
  user               PramanUser @relation(fields: [pramanUserId], references: [id], onDelete: Cascade)
  project            Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([pramanUserId, projectId])
  @@map("consent_records")
}

// ---------------- 11. VERIFICATION SESSIONS (OAUTH2 / PKCE) ----------------
model VerificationSession {
  id            String    @id @default(uuid())
  projectId     String    @map("project_id")
  pramanUserId  String?   @map("praman_user_id")
  nonceHash     String    @map("nonce_hash") // Single-use challenge nonce
  audience      String    // Target client_id
  sessionStatus String    @default("INITIATED") @map("session_status") // INITIATED, VERIFIED, EXCHANGED, EXPIRED, REJECTED
  authCode      String?   @unique @map("auth_code")
  redirectUri   String    @map("redirect_uri")
  codeChallenge String    @map("code_challenge")
  pairwiseId    String?   @map("pairwise_id")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("verification_sessions")
}

// ---------------- 12. VERIFICATION EVENTS ----------------
model VerificationEvent {
  id                 String   @id @default(uuid())
  projectId          String   @map("project_id")
  pramanUserId       String?  @map("praman_user_id")
  verificationStatus String   @map("verification_status") // SUCCESS, FAILED
  verificationMethod String   @default("ZK_GROTH16") @map("verification_method") // ZK_GROTH16, WEBAUTHN
  circuitVersion     String   @default("Groth16_BN254_v1") @map("circuit_version")
  latencyMs          Int      @default(0) @map("latency_ms")
  createdAt          DateTime @default(now()) @map("created_at")
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("verification_events")
}

// ---------------- 13. AUDIT LOGS ----------------
model AuditLog {
  id           String    @id @default(uuid())
  actorId      String    @map("actor_id")
  projectId    String?   @map("project_id")
  action       String    // CREATE_KEY, REVOKE_KEY, ADD_DOMAIN, VERIFY_DOMAIN, REENROLL_TEMPLATE
  resourceType String    @map("resource_type") // PROJECT, API_KEY, DOMAIN, TEMPLATE
  resourceId   String    @map("resource_id")
  metadata     String?   // Sanitized JSON (zero secrets or biometric vectors)
  createdAt    DateTime  @default(now()) @map("created_at")
  developer    Developer @relation(fields: [actorId], references: [id], onDelete: Cascade)
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ---------------- 14. SUBSCRIPTIONS & LIMITS ----------------
model Subscription {
  id                       String    @id @default(uuid())
  developerId              String    @map("developer_id")
  projectId                String    @map("project_id")
  plan                     String    @default("DEVELOPER_FREE") // DEVELOPER_FREE, PRO_SCALE, ENTERPRISE
  status                   String    @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED
  monthlyVerificationLimit Int       @default(10000) @map("monthly_verification_limit")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  developer                Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  project                  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([developerId, projectId])
  @@map("subscriptions")
}
